# Kopier til .env for lokal kjøring. I GitHub Actions ligger disse i repository secrets.
ANTHROPIC_API_KEY=
# EskomSePush (gratis token): https://eskomsepush.gumroad.com/l/api
SEPUSH_TOKEN=
# Privat iCal-URL fra Google Calendar (Innstillinger -> Integrer kalender -> Hemmelig adresse)
CALENDAR_ICS_URL=
# Linear personlig API-nøkkel (linear.app -> Settings -> Security & access -> API keys)
LINEAR_API_KEY=
# Valgfritt: begrens gjøremålstavlen til ett Linear-prosjekt
LINEAR_PROJECT=CapeTasks
